{
  "name": "dsh-compact-receipt",
  "version": "0.4.0-beta.1",
  "description": "[BETA] Compaction receipts for DeepSeek Harness: audit what a compaction dropped, and (experimental) take over compaction to pin requirements verbatim. 压缩收据（测试版）。",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "compaction",
    "context",
    "memory"
  ],
  "license": "MIT",
  "author": "cty-09",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cty-09/dsh-compact-receipt.git"
  },
  "homepage": "https://github.com/cty-09/dsh-compact-receipt",
  "scripts": {
    "build": "esbuild lib/index.js --bundle --format=esm --platform=node --outfile=dist/index.js",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.2",
    "esbuild": "^0.25.9"
  }
}
